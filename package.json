{
  "name": "stagecredit",
  "version": "1.0.2",
  "description": "StageCredit — stage timer by Sound Credit TV",
  "author": "Sound Credit TV",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:all": "electron-builder --mac --win"
  },
  "devDependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "tv.soundcredit.stagecredit",
    "productName": "StageCredit",
    "files": [
      "main.js",
      "preload.js",
      "preload-control.js",
      "preload-display.js",
      "server.js",
      "asrun.js",
      "control.html",
      "display.html",
      "remote.html",
      "fonts/**"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "ws": "^8.21.1"
  }
}
